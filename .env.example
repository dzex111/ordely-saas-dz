# ---------- Database (Postgres — local or Supabase pooler URL) ----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ---------- Supabase (switches Auth + Storage to Supabase automatically) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=store-media

# ---------- Multi-tenant domains ----------
# Root domain merchants get subdomains under. In dev, stores are also reachable at /{subdomain}.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Set to "true" in production so dashboard links open https://{sub}.{ROOT_DOMAIN}
NEXT_PUBLIC_USE_SUBDOMAINS=false

# ---------- Billing providers (optional) ----------
CHARGILY_SECRET_KEY=
STRIPE_SECRET_KEY=
